* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #0d0d0d;
    color: #fff;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-image: radial-gradient(circle at 50% 0%, #2a0000 0%, #0d0d0d 70%);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

header {
    text-align: center;
    padding: 40px 20px;
    border-bottom: 2px solid #ff0000;
    box-shadow: 0 0 20px #ff0000;
}

header h1 {
    font-size: 3em;
    letter-spacing: 3px;
    color: #ff0000;
    text-shadow: 0 0 10px #ff0000, 0 0 20px #ff0000, 0 0 40px #ff0000;
    animation: pulsar 2s infinite;
}

@keyframes pulsar {
    0%, 100% { text-shadow: 0 0 10px #ff0000, 0 0 20px #ff0000; }
    50% { text-shadow: 0 0 20px #ff0000, 0 0 40px #ff0000, 0 0 60px #ff0000; }
}

header p {
    font-size: 1.2em;
    color: #ff6666;
    margin-top: 10px;
}

.scripts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
    padding: 30px;
    max-width: 1200px;
    margin: 0 auto;
}

.card {
    background-color: #1a1a1a;
    border: 1px solid #ff0000;
    border-radius: 10px;
    padding: 15px;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 10px rgba(255, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 20px #ff0000;
}

.card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 5px;
    border: 1px solid #ff3333;
    background-color: #333;
}

.card h2 {
    font-size: 1.2em;
    margin: 10px 0;
    color: #ff3333;
    flex-grow: 1;
}

.card .fonte {
    font-size: 0.8em;
    color: #999;
    margin-bottom: 10px;
}

.card a {
    display: inline-block;
    background-color: #ff0000;
    color: #fff;
    padding: 10px 15px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
    text-align: center;
    transition: background-color 0.2s;
}

.card a:hover {
    background-color: #cc0000;
}

footer {
    text-align: center;
    padding: 20px;
    border-top: 1px solid #ff0000;
    color: #ff6666;
    margin-top: auto;
}

#loading {
    font-size: 1.5em;
    color: #ff0000;
    text-align: center;
    padding: 30px;
}
